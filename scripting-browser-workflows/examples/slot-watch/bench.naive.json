{
  "setup": [
    "node",
    "setcase.mjs",
    "{case}"
  ],
  "cases": {
    "many": {
      "expect": {
        "status": "open",
        "slots": [
          "10:30",
          "13:00",
          "17:00"
        ]
      }
    },
    "one": {
      "expect": {
        "status": "open",
        "slots": [
          "13:00"
        ]
      }
    },
    "none": {
      "expect": {
        "status": "none",
        "slots": []
