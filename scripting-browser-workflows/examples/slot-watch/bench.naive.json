    },
    "drift": {
      "expect": {
        "status": "drift",
        "slots": [],
        "why": "page loaded, slot markup gone"
      },
      "comment": "slots ARE open here; the class was renamed. naive answers none = blind."
    }
  },
  "backends": {
    "naive": [
      "node",
      "run.naive.mjs"
    ],
    "cdp": [
      "node",
      "run.cdp.mjs"
    ]
  }
